# ---------------------------------------------------------------------------
# BluConnet Media - the React SPA and WordPress share this document root.
#
# The SPA owns the client-side routes (/blog, /news, /services/...), while
# WordPress owns the REST API that the public /blog page consumes.
#
# A blanket "everything -> /index.html" rule ALSO swallowed /wp-json/... so the
# WordPress REST API answered with the SPA shell (text/html) instead of JSON.
# Calling response.json() on that HTML produced:
#     SyntaxError: Unexpected token "<", "<!doctype ..." is not valid JSON
#
# WordPress REST requests are therefore routed to WordPress own front
# controller using the ?rest_route= form (the same form WordPress uses
# internally), and only non-WordPress paths fall through to the SPA shell.
#
# Elementor editor / preview requests (?elementor-preview=..., ?preview=true,
# &action=elementor, /wp-admin/...) must likewise never fall through to the
# SPA shell, otherwise Elementor reports "The preview could not be loaded".
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# SECURITY HEADERS (M2)
#
# Sent with every response of this document root — the React SPA and the
# WordPress site share it. Kept deliberately conservative so nothing breaks:
#   • no Content-Security-Policy here. A CSP that reaches WordPress +
#     Elementor output has to allow inline styles/scripts, third-party plugin
#     CDNs, fonts, analytics, wp-admin iframes …; one missing source and the
#     editor or the site silently stops working. The backend API (Render)
#     already sends its own strict CSP for the JSON service it owns.
#   • X-Frame-Options SAMEORIGIN (not DENY): the Elementor editor and the
#     WordPress customizer preview their own pages inside same-origin iframes.
#   • HSTS is only set on HTTPS responses, so the plain-http vhost used by
#     some ACME/health checks is untouched.
# ---------------------------------------------------------------------------
<IfModule mod_setenvif.c>
  SetEnvIfExpr "%{HTTPS} == 'on'" BC_HTTPS
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), fullscreen=(self)"
  Header always set Strict-Transport-Security "max-age=31536000" env=BC_HTTPS
  Header always unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # -------------------------------------------------------------------------
  # SENSITIVE FILES — denied BEFORE the "serve real files as-is" rule below,
  # otherwise a real file (wp-config.php, .env, a stray .sql dump) would be
  # handed out before any deny rule ever ran. /.well-known is explicitly NOT
  # blocked: that is where the ACME (AutoSSL) challenges live, and blocking it
  # would break certificate renewal.
  # xmlrpc.php is left ALONE on purpose — Jetpack / pingbacks / the WordPress
  # app depend on it; block it here only if the site does not use them.
  # -------------------------------------------------------------------------
  RewriteCond %{REQUEST_URI} (^|/)\.(?!well-known) [NC,OR]
  RewriteCond %{REQUEST_URI} \.(env|ini|conf|cfg|log|sql|sql\.gz|sqlite|sqlite3|bak|backup|old|orig|save|swp|swo|dist|sh|bak\.php|php\.bak|php~|inc)(/|$|\?) [NC,OR]
  RewriteCond %{REQUEST_URI} ^/(composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|npm-shrinkwrap\.json|README\.md|readme\.html|CHANGELOG\.md|wp-config\.php) [NC,OR]
  RewriteCond %{REQUEST_URI} ^/wp-content/(debug\.log|object-cache\.php\.bak|backups?/) [NC,OR]
  # No PHP ever executes from the uploads folder: that is the first thing an
  # attacker who managed to upload a file reaches for. WordPress core, plugins
  # and Elementor all keep their PHP outside uploads/.
  RewriteCond %{REQUEST_URI} ^/wp-content/uploads/.*\.(php[0-9]*|phar|pl|py|cgi|sh|asp|js\.php)$ [NC]
  RewriteRule .* - [F,L]


  # 3c-0) Homepage preview ("/?p=123&elementor-preview=.."): path is empty,
  #      docroot always matches -d, so handle BEFORE the file/dir passthrough.
  #      Plain "/" (no query) still falls through to the SPA homepage.
  RewriteCond %{QUERY_STRING} (^|&)(rest_route|elementor-preview|elementor|preview|preview_id|preview_nonce|theme_template_id|autosave)= [NC,OR]
  RewriteCond %{QUERY_STRING} (^|&)action=elementor [NC,OR]
  RewriteCond %{QUERY_STRING} (^|&)preview=true [NC]
  RewriteRule ^$ /index.php [L,QSA]

  # 1) Real files and directories (built JS/CSS, images, logo, wp-login.php,
  #    wp-content assets, ...) are always served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # 2) WordPress REST API -> WordPress front controller.
  #    /wp-json/wp/v2/posts -> /index.php?rest_route=/wp/v2/posts
  #    the original query string is preserved via [QSA], so _embed, per_page,
  #    page, slug, ... keep working.
  RewriteRule ^wp-json/?$ /index.php?rest_route=/ [L,QSA]
  RewriteRule ^wp-json/(.*)$ /index.php?rest_route=/$1 [L,QSA]

  # 3) WordPress own front controller must never be rewritten.
  RewriteRule ^index\.php$ - [L]

  # 3b) WordPress system paths must never fall through to the SPA shell.
  #     Real files under these paths are already served by rule (1) above;
  #     anything remaining (e.g. /wp-admin/ directory loads, admin-ajax.php)
  #     belongs to WordPress / Elementor.
  RewriteRule ^wp-admin(/|$) /index.php [L,QSA]
  RewriteRule ^wp-login\.php$ - [L]
  RewriteRule ^wp-cron\.php$ - [L]
  RewriteRule ^xmlrpc\.php$ - [L]

  # 3c) Elementor editor / preview / autosave query strings must go to WP.
  #     NOTE: RewriteRule matches the URL-path only, never the query string,
  #     so "?elementor-preview=..&preview=true" has to be matched via
  #     QUERY_STRING. Without this, "/?p=123&elementor-preview=.." falls
  #     through to /index.html and Elementor reports
  #     "The preview could not be loaded".
  RewriteCond %{QUERY_STRING} (^|&)(rest_route|elementor-preview|elementor|preview|preview_id|preview_nonce|theme_template_id|autosave)= [NC,OR]
  RewriteCond %{QUERY_STRING} (^|&)action=elementor [NC,OR]
  RewriteCond %{QUERY_STRING} (^|&)preview=true [NC]
  RewriteRule ^ /index.php [L,QSA]

  # 4) Every other path is a React client-side route -> serve the SPA shell.
  RewriteRule . /index.html [L]
</IfModule>


