# Production build (npm run build, NODE_ENV=production).
# This file overrides .env during `npm run build`, so the built bundle
# talks to the production backend instead of localhost.
# If the backend lives on a different host, set REACT_APP_API_URL to that
# host's public URL (with /api path) at build time.
REACT_APP_API_URL=https://bluconnetmedia.com/api