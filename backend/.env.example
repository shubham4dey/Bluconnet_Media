# BluConnet AI backend — production template.
# Copy to `.env` and fill in real values. Never commit `.env`.
PORT=5000
NODE_ENV=production

# Production frontend origin(s) allowed by CORS (comma separated)
FRONTEND_ORIGIN=https://bluconnetmedia.com,https://www.bluconnetmedia.com

# Admin dashboard credentials
ADMIN_USER=
ADMIN_PASS=

# Outgoing webhooks (optional)
WEBHOOK_URL=
CRM_WEBHOOK_URL=

# Email notifications (optional — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=info@bluconnetmedia.com

# ---------------------------------------------------------------
# MySQL — REQUIRED for the contact forms (POST /api/contact)
# Every Hero / Home / Contact-page enquiry is stored in the
# MySQL `contacts` table. Credentials live here only, never in code.
# Apply the schema with:  npm run migrate
# Verify stored rows with: npm run contacts:verify
# ---------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bluconnet_media
MYSQL_CONNECTION_LIMIT=10

# Optional: a single connection string overrides the four values above
# MYSQL_URL=mysql://user:password@host:3306/bluconnet_media

# Optional: managed MySQL that requires TLS
MYSQL_SSL=false
# MYSQL_SSL_REJECT_UNAUTHORIZED=false

# Google Gemini API (optional — leave blank to disable AI answers)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------
# Cloudinary — REQUIRED for News image uploads from the Admin panel.
# Images are stored permanently on Cloudinary (the local /uploads
# folder is wiped by Render on every restart/redeploy). The cloud
# already used by the BluConnet website/blog is `wyixfdon`.
# Credentials live here only, never in code.
# Dashboard → Settings → API Keys gives the key + secret.
# ---------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=wyixfdon
CLOUDINARY_API_KEY=658358377744667
CLOUDINARY_API_SECRET=j5Eb0pYidHyEhcW4VwnIN8i37Hg
# Folder for uploaded news images (optional, default bluconnet/news)
CLOUDINARY_NEWS_FOLDER=bluconnet/news
# Alternative to the three vars above (SDK-native single URL):
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ---------------------------------------------------------------
# News articles — stored in MySQL (the `news` table, created by
# `npm run migrate`, same database as contacts/subscribers) with
# `backend/data/news.json` kept as a local read mirror.
#
#   NEWS_REQUIRE_DB   true  → a write that cannot reach MySQL fails with
#                             503 and stores nothing (no article is ever
#                             reported as saved when it is not durable).
#                     Default: true when NODE_ENV=production, else false.
#                     Set false to allow a mirror-only development setup.
#   NEWS_IMPORT_MIRROR
#                     true (default) → on boot, articles that only exist in
#                             the local mirror are imported into MySQL
#                             (INSERT IGNORE — never a duplicate).
#                     Set false on a DEV machine that points at the
#                     PRODUCTION database, so local test articles are never
#                     pushed into it.
#   NEWS_DB_REFRESH_MS
#                     0 (default, disabled) → how often the local mirror is
#                             re-read from MySQL (only useful with several
#                             instances or manual SQL access).
# ---------------------------------------------------------------
# NEWS_REQUIRE_DB=true
# NEWS_IMPORT_MIRROR=true
# NEWS_DB_REFRESH_MS=0
