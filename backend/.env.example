# BluConnet AI backend — production template.
# Copy to `.env` and fill in real values. Never commit `.env`.
PORT=5000
NODE_ENV=production

# Production frontend origin(s) allowed by CORS (comma separated)
FRONTEND_ORIGIN=https://bluconnetmedia.com,https://www.bluconnetmedia.com

# Admin dashboard credentials
# SECURITY: both are REQUIRED — there is no built-in fallback any more. When
# either is missing, POST /api/admin/login answers 503 (fail closed) instead of
# accepting a well-known default password.
ADMIN_USER=
ADMIN_PASS=

# Optional: protects the /health storage details (database target + last
# connection error). Set it on Render and send it as the `x-health-token`
# header when the full report is needed; without this variable the response
# stays exactly as before.
# HEALTH_TOKEN=

# Outgoing webhooks (optional)
WEBHOOK_URL=
CRM_WEBHOOK_URL=

# Email notifications (optional — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=info@bluconnetmedia.com

# ---------------------------------------------------------------
# MySQL — REQUIRED for the contact forms (POST /api/contact) AND
# for the News CMS (articles live in the same database).
#
# PRODUCTION (Namecheap + Render on different hosts):
#   Namecheap only exposes the cPanel SSH port, NOT MySQL 3306, so a
#   backend running anywhere else must reach the database through the
#   SSH tunnel below.
#
#   NAMECHEAP_SSH_HOST=66.29.132.129      (cPanel server)
#   NAMECHEAP_SSH_PORT=21098              (cPanel SSH port)
#   NAMECHEAP_SSH_USER=<cpanel user>
#   NAMECHEAP_SSH_KEY_B64=<private key, base64-encoded, single line>
#   NAMECHEAP_SSH_PASSPHRASE=<only if the key has one>
#
#   MYSQL_DATABASE must be the FULL cPanel name of the database, which
#   is prefixed with the cPanel account, e.g. bluchknj_bluconnet_media
#   (a bare `bluconnet_media` does not exist on the server and makes
#   every query fail with ER_BAD_DB_ERROR).
#
# Every value may also be given as DB_HOST / DB_PORT / DB_USER /
# DB_PASSWORD / DB_NAME — both namings are accepted.
# Apply the schema with:  npm run migrate
# Verify stored rows with: npm run contacts:verify
# Verify news rows with:   npm run news:verify
# ---------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bluconnet_media
MYSQL_CONNECTION_LIMIT=10

# Seconds to wait for the FIRST connection. The first connect of a deploy has
# to survive the SSH handshake above, so this is deliberately longer than
# mysql2's 10s default. Raise it if a cold start + tunnel still times out.
MYSQL_CONNECT_TIMEOUT=20000

# Optional: a single connection string overrides the four values above
# MYSQL_URL=mysql://user:password@host:3306/bluchknj_bluconnet_media

# Optional: managed MySQL that requires TLS
MYSQL_SSL=false
# MYSQL_SSL_REJECT_UNAUTHORIZED=false

# Google Gemini API (optional — leave blank to disable AI answers)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------
# Cloudinary — REQUIRED for News image uploads from the Admin panel.
# Images are stored permanently on Cloudinary (the local /uploads
# folder is wiped by Render on every restart/redeploy). The cloud
# already used by the BluConnet website/blog is `wyixfdon`.
# Credentials live here only, never in code.
# Dashboard → Settings → API Keys gives the key + secret.
# ---------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=wyixfdon
# SECURITY: placeholders only — NEVER paste a real key/secret into this file.
# It is committed, so any real value here is public forever (this exact file
# previously contained the live account's key + secret). Put the real values in
# the service environment (Render → Environment) and in the untracked `.env`.
# If a secret ever lands here, ROTATE it in the Cloudinary dashboard.
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>
# Folder for uploaded news images (optional, default bluconnet/news)
CLOUDINARY_NEWS_FOLDER=bluconnet/news
# Alternative to the three vars above (SDK-native single URL):
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ---------------------------------------------------------------
# News articles — stored in MySQL (the `news` table, created by
# `npm run migrate`, same database as contacts/subscribers) with
# `backend/data/news.json` kept as a local read mirror.
#
#   NEWS_REQUIRE_DB   true  → a write that cannot reach MySQL fails with
#                             503 and stores nothing (no article is ever
#                             reported as saved when it is not durable).
#                     Default: true when NODE_ENV=production, else false.
#                     Set false to allow a mirror-only development setup.
#   NEWS_IMPORT_MIRROR
#                     true (default) → on boot, articles that only exist in
#                             the local mirror are imported into MySQL
#                             (INSERT IGNORE — never a duplicate).
#                     Set false on a DEV machine that points at the
#                     PRODUCTION database, so local test articles are never
#                     pushed into it.
#   NEWS_DB_REFRESH_MS
#                     60000 (default) → how often the mirror is re-read from
#                             MySQL. This also heals a connection that failed
#                             at boot, and picks up rows written directly in
#                             phpMyAdmin within a minute. 0 disables it.
#   NEWS_BOOT_RETRY_MS
#                     5000 (default) → delay between the boot connection
#                             attempts (the first connect of an instance has to
#                             wait for the Namecheap SSH handshake).
#   NEWS_BOOT_RETRY_MAX
#                     6 (default) → boot connection attempts before the API
#                             starts serving the local mirror as-is; the
#                             watchdog keeps retrying afterwards.
# ---------------------------------------------------------------
# NEWS_REQUIRE_DB=true
# NEWS_IMPORT_MIRROR=true
# NEWS_DB_REFRESH_MS=60000
# NEWS_BOOT_RETRY_MS=5000
# NEWS_BOOT_RETRY_MAX=6

# ---------------------------------------------------------------
# Google reCAPTCHA v3 — REQUIRED for public form submissions:
# POST /api/contact, POST /api/subscribe, POST /api/lead,
# POST /api/meeting, POST /api/application, POST /api/handoff,
# POST /api/feedback.
# The server verifies the client's token with Google siteverify.
# The secret key lives here only, never in code or client bundles.
# ---------------------------------------------------------------
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
# Minimum score for a token to be accepted (default 0.5, 0.0 - 1.0)
RECAPTCHA_MIN_SCORE=0.5
# Optional: comma-separated extra allowed hostnames beyond FRONTEND_ORIGIN
# RECAPTCHA_ALLOWED_HOSTS=bluconnetmedia.com,www.bluconnetmedia.com

# ---------------------------------------------------------------
# Google reCAPTCHA v2 Checkbox (Optional backend verification)
# Client renders with REACT_APP_RECAPTCHA_V2_SITE_KEY.
# If server-side verification of v2 tokens is enabled in the future,
# populate this on Render only. Never put the actual secret here.
# ---------------------------------------------------------------
# RECAPTCHA_V2_SECRET_KEY=your_recaptcha_v2_secret_key_here

