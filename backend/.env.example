# BluConnet AI backend — production template.
# Copy to `.env` and fill in real values. Never commit `.env`.
PORT=5000
NODE_ENV=production

# Production frontend origin(s) allowed by CORS (comma separated)
FRONTEND_ORIGIN=https://bluconnetmedia.com,https://www.bluconnetmedia.com

# Admin dashboard credentials
ADMIN_USER=
ADMIN_PASS=

# Outgoing webhooks (optional)
WEBHOOK_URL=
CRM_WEBHOOK_URL=

# Email notifications (optional — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=info@bluconnetmedia.com

# ---------------------------------------------------------------
# MySQL — REQUIRED for the contact forms (POST /api/contact)
# Every Hero / Home / Contact-page enquiry is stored in the
# MySQL `contacts` table. Credentials live here only, never in code.
# Apply the schema with:  npm run migrate
# Verify stored rows with: npm run contacts:verify
# ---------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bluconnet_media
MYSQL_CONNECTION_LIMIT=10

# Optional: a single connection string overrides the four values above
# MYSQL_URL=mysql://user:password@host:3306/bluconnet_media

# Optional: managed MySQL that requires TLS
MYSQL_SSL=false
# MYSQL_SSL_REJECT_UNAUTHORIZED=false

# Google Gemini API (optional — leave blank to disable AI answers)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
